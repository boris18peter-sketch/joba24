  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#ffffffff",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    }
  }
}