{
  "appId": "com.base69e6bdb4986a04a256653a23.app",
  "appName": "Joba24",
  "webDir": "dist",
  "server": {
    "url": "https://joba24.com/",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": [
      "base44.app",
      "*.base44.app",
      "accounts.google.com",
      "www.google.com",
      "google.com",
      "appleid.apple.com",
