{
  "appId": "com.base69e6bdb4986a04a256653a23.app",
  "appName": "Joba24",
  "webDir": "dist",
  "backgroundColor": "#f2f5fb",
  "server": {
    "url": "https://joba24.com/",
    "cleartext": false,
    "androidScheme": "https",
    "allowNavigation": [
      "accounts.google.com",
      "appleid.apple.com",
      "www.facebook.com",
      "*.base44.app"
    ]
  },
  "experimental": {
    "ios": {
      "spm": {
        "packageOptions": {
          "@capacitor-firebase/analytics": { "symlink": true }
        }
      }
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1000,
      "launchAutoHide": true,
      "backgroundColor": "#f2f5fb",
      "showSpinner": false
    }
  }
}