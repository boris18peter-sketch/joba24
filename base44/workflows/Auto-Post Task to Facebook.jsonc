{
  "name": "Auto-Post Task to Facebook",
  "description": "\u05db\u05dc \u05de\u05e9\u05d9\u05de\u05d4 \u05d7\u05d3\u05e9\u05d4 \u05e9\u05e0\u05d5\u05e6\u05e8\u05ea \u05de\u05e4\u05d5\u05e8\u05e1\u05de\u05ea \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05db\u05e4\u05d5\u05e1\u05d8 \u05d1\u05e2\u05de\u05d5\u05d3 \u05d4\u05e4\u05d9\u05d9\u05e1\u05d1\u05d5\u05e7 \u05e9\u05dc Joba24",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Task",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.status == \"OPEN\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_post_facebook",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "post_to_facebook": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "facebookPagesManager",
            "args": {
              "action": "post",
              "task_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u05e4\u05e8\u05e1\u05d5\u05dd \u05d1\u05e4\u05d9\u05d9\u05e1\u05d1\u05d5\u05e7",
            "description": "\u05e4\u05d5\u05e1\u05d8 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9 \u05e9\u05dc \u05d4\u05de\u05e9\u05d9\u05de\u05d4 \u05d1\u05e2\u05de\u05d5\u05d3"
          }
        }
      }
    ]
  }
}