{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "Asia/Jerusalem",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Abandoned Publish Reminder",
  "description": "Reminds a publisher who started a task and stopped before publishing \u2014 one nudge, at most once a week per person.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "abandoned_publish_reminder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "remind_abandoned_publish": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyAbandonedPublish",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "\u05ea\u05d6\u05db\u05d5\u05e8\u05ea \u05dc\u05e4\u05e8\u05e1\u05d5\u05dd \u05e9\u05dc\u05d0 \u05d4\u05d5\u05e9\u05dc\u05dd",
            "description": "\u05de\u05d9 \u05e9\u05d4\u05ea\u05d7\u05d9\u05dc \u05d5\u05dc\u05d0 \u05e1\u05d9\u05d9\u05dd \u2014 \u05d0\u05d7\u05e8\u05d9 \u05e9\u05e2\u05ea\u05d9\u05d9\u05dd"
          }
        }
      }
    ]
  }
}