{
  "name": "Market Maker",
  "description": "\u05de\u05e8\u05d9\u05e5 \u05db\u05dc \u05e9\u05e2\u05d4 \u05de\u05d7\u05d6\u05d5\u05e8 Market Making: \u05de\u05e4\u05e8\u05e1\u05dd 5-10 \u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05d3\u05de\u05d5, \u05de\u05d5\u05e1\u05d9\u05e3 \u05e6\u05e4\u05d9\u05d5\u05ea/\u05db\u05e0\u05d9\u05e1\u05d5\u05ea/\u05e4\u05e0\u05d9\u05d5\u05ea \u05dc\u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05d4\u05e7\u05d9\u05d9\u05de\u05d5\u05ea \u05d5\u05e1\u05d5\u05d2\u05e8 \u05d0\u05ea \u05d4\u05d9\u05e9\u05e0\u05d5\u05ea. \u05d4\u05de\u05d7\u05d6\u05d5\u05e8 \u05de\u05ea\u05d1\u05e6\u05e2 \u05d1\u05e4\u05d5\u05e2\u05dc \u05e8\u05e7 \u05db\u05e9\u05e2\u05d1\u05e8 \u05e4\u05e8\u05e7 \u05d4\u05d6\u05de\u05df \u05e9\u05d4\u05d5\u05d2\u05d3\u05e8 \u05d1\u05e1\u05d9\u05de\u05d5\u05dc\u05d8\u05d5\u05e8.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
