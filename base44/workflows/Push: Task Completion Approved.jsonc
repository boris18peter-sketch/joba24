{
  "name": "Push: Task Completion Approved",
  "description": "\u05e9\u05d5\u05dc\u05d7 push \u05db\u05e9\u05de\u05e4\u05e8\u05e1\u05dd \u05de\u05d0\u05e9\u05e8 \u05d0\u05ea \u05e1\u05d9\u05d5\u05dd \u05d1\u05d9\u05e6\u05d5\u05e2 \u05d4\u05de\u05e9\u05d9\u05de\u05d4",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"client_confirmed\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Task"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "push_task_completion_approved",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyTaskCompleted",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyTaskCompleted"
  }
}