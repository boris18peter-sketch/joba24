{
  "name": "BrandCategory",
  "type": "object",
  "properties": {
    "brand_id": {
      "type": "string",
      "description": "Brand.id (ADR-23). Which Brand this category belongs to."
    },
    "category_key": {
      "type": "string",
      "description": "Stable machine key, matching the Task.category enum (e.g. plumbing, cleaning, moving)."
    },
    "label": {
      "type": "string",
      "description": "Display label for this Brand. Falls back to the platform label when unset."
    },
    "icon": {
      "type": "string",
      "description": "Icon key or emoji used in the Brand's UI."
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this category is offered on this Brand."
    },
    "form_config": {
      "type": "object",
      "additionalProperties": true,
      "description": "Brand-specific task-form configuration for this category: which extra fields to show, default requirements, default urgency. Unset keys inherit from the platform."
    }
  },
  "required": [
    "brand_id",
    "category_key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}