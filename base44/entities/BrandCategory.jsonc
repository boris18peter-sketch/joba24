{
  "name": "BrandCategory",
  "type": "object",
  "properties": {
    "brand_id": {
      "type": "string",
      "description": "Brand.id (ADR-23). Which Brand this category belongs to."
    },
    "category_key": {
      "type": "string",
      "description": "Points at a GlobalCategory.category_key. The category DEFINITION and its task form are global; this row only says whether THIS Brand offers it."
    },
    "label": {
      "type": "string",
      "description": "Optional Brand-facing display label. Empty = inherit the global label."
    },
    "icon": {
      "type": "string",
      "description": "Optional Brand-facing icon override. Empty = inherit the global icon."
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "This Brand's own ordering of the categories it offers."
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this category is offered on this Brand."
    },
    "form_config": {
      "type": "object",
      "additionalProperties": true,
      "description": "DEPRECATED and unused. Task forms are global per category (GlobalCategory.fields). Retained only so no historical value is destroyed; nothing reads or writes it."
    }
  },
  "required": [
    "brand_id",
    "category_key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}