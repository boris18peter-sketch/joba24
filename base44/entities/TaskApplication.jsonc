{
  "name": "TaskApplication",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string"
    },
    "task_title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05de\u05e9\u05d9\u05de\u05d4 \u2014 \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-notifications"
    },
    "worker_id": {
      "type": "string"
    },
    "worker_name": {
      "type": "string"
    },
    "worker_score": {
      "type": "number"
    },
    "worker_rating": {
      "type": "number"
    },
    "worker_tasks_count": {
      "type": "number"
    },
    "worker_verified": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05e2\u05d5\u05d1\u05d3 \u05de\u05d0\u05d5\u05de\u05ea \u05d1\u05d6\u05de\u05df \u05d4\u05d2\u05e9\u05ea \u05d4\u05d1\u05e7\u05e9\u05d4"
    },
    "message": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05e9\u05d4\u05e2\u05d5\u05d1\u05d3 \u05e6\u05d9\u05e8\u05e3 \u05dc\u05d1\u05e7\u05e9\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "cancelled"
      ],
      "default": "pending"
    },
    "credits_charged": {
      "type": "number",
      "default": 0,
      "description": "\u05db\u05de\u05d5\u05ea \u05d4\u05e7\u05e8\u05d3\u05d9\u05d8\u05d9\u05dd \u05e9\u05e0\u05d2\u05d1\u05d5 \u05de\u05d4\u05e2\u05d5\u05d1\u05d3 \u05d1\u05e2\u05ea \u05d4\u05d2\u05e9\u05ea \u05d4\u05de\u05d5\u05e2\u05de\u05d3\u05d5\u05ea"
    },
    "surface_brand_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05d5\u05ea\u05d2 \u05e9\u05d3\u05e8\u05db\u05d5 \u05d4\u05d5\u05d2\u05e9\u05d4 \u05d4\u05d1\u05e7\u05e9\u05d4 (surface brand) \u2014 \u05e9\u05d5\u05e0\u05d4 \u05de-origin_brand_id \u05e9\u05dc \u05d4\u05de\u05e9\u05d9\u05de\u05d4. nullable \u2014 \u05e8\u05e9\u05d5\u05de\u05d5\u05ea \u05e7\u05d9\u05d9\u05de\u05d5\u05ea \u05e0\u05e9\u05d0\u05e8\u05d5\u05ea \u05dc\u05dc\u05d0 \u05e2\u05e8\u05da."
    },
    "schedule_snapshot": {
      "type": "string",
      "description": "\u05d7\u05ea\u05d9\u05de\u05ea \u05dc\u05d5\u05d7 \u05d4\u05d6\u05de\u05e0\u05d9\u05dd \u05e9\u05dc \u05d4\u05de\u05e9\u05d9\u05de\u05d4 \u05d1\u05de\u05d5\u05e2\u05d3 \u05d4\u05d2\u05e9\u05ea \u05d4\u05d1\u05e7\u05e9\u05d4 (scheduleSignature). \u05d1\u05d7\u05d9\u05e8\u05ea \u05d4\u05e2\u05d5\u05d1\u05d3 \u05e0\u05d7\u05e9\u05d1\u05ea \u05dc\u05d4\u05e1\u05db\u05de\u05d4 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05e2\u05dc \u05d4\u05de\u05d5\u05e2\u05d3 \u05e8\u05e7 \u05d0\u05dd \u05d4\u05dc\u05d5\u05d7 \u05dc\u05d0 \u05d4\u05e9\u05ea\u05e0\u05d4 \u05de\u05d0\u05d6 \u2014 \u05db\u05dc\u05d5\u05de\u05e8 \u05d4\u05e2\u05d5\u05d1\u05d3 \u05e0\u05d1\u05d7\u05e8 \u05d1\u05d3\u05d9\u05d5\u05e7 \u05dc\u05de\u05d5\u05e2\u05d3 \u05e9\u05d4\u05d5\u05d0 \u05e8\u05d0\u05d4. \u05e8\u05d9\u05e7 \u05d1\u05e8\u05e9\u05d5\u05de\u05d5\u05ea legacy."
    },
    "client_id": {
      "type": "string",
      "description": "\u05d1\u05e2\u05dc \u05d4\u05de\u05e9\u05d9\u05de\u05d4 (Task.client_id) \u2014 \u05de\u05e0\u05d5\u05e8\u05de\u05dc \u05de-Task \u05d4\u05d0\u05d1 \u05db\u05d3\u05d9 \u05e9\u05d0\u05db\u05d9\u05e4\u05ea \u05d4\u05d1\u05e2\u05dc\u05d5\u05ea \u05ea\u05d4\u05d9\u05d4 \u05e0\u05d9\u05ea\u05e0\u05ea \u05dc\u05d1\u05d9\u05d8\u05d5\u05d9 \u05d1-RLS. \u05e0\u05db\u05ea\u05d1 \u05ea\u05de\u05d9\u05d3 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05d4\u05e9\u05e8\u05ea \u05de\u05ea\u05d5\u05da \u05d4\u05de\u05e9\u05d9\u05de\u05d4 \u05d4\u05e0\u05e9\u05de\u05e8\u05ea; \u05dc\u05e2\u05d5\u05dc\u05dd \u05dc\u05d0 \u05de\u05d4\u05dc\u05e7\u05d5\u05d7."
    }
  },
  "required": [
    "task_id",
    "worker_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.worker_id": "{{user.id}}"
        },
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.worker_id": "{{user.id}}"
        },
        {
          "data.client_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}