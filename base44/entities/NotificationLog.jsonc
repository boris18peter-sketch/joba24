{
  "name": "NotificationLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05e7\u05d9\u05d1\u05dc \u05d0\u05ea \u05d4\u05d4\u05ea\u05e8\u05d0\u05d4"
    },
    "event_key": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2 \u05de\u05ea\u05d5\u05da NotificationConfig"
    },
    "occurrence_key": {
      "type": "string",
      "description": "\u05e2\u05d5\u05d2\u05df \u05d4-idempotency \u05dc\u05d4\u05ea\u05e8\u05d0\u05d5\u05ea \u05de\u05d1\u05d5\u05e1\u05e1\u05d5\u05ea-\u05d6\u05de\u05df: task_id + \u05de\u05d5\u05e2\u05d3 \u05d4\u05d4\u05ea\u05e8\u05d7\u05e9\u05d5\u05ea. \u05de\u05d0\u05e4\u05e9\u05e8 \u05dc\u05e9\u05dc\u05d5\u05d7 \u05d4\u05ea\u05e8\u05d0\u05ea '\u05de\u05ea\u05d7\u05d9\u05dc \u05d1\u05e7\u05e8\u05d5\u05d1' \u05e4\u05e2\u05dd \u05d0\u05d7\u05ea \u05d1\u05dc\u05d1\u05d3 \u05dc\u05db\u05dc \u05de\u05e9\u05d9\u05de\u05d4+\u05de\u05d5\u05e2\u05d3+\u05e0\u05de\u05e2\u05df, \u05d2\u05dd \u05d0\u05dd \u05d4-workflow \u05e8\u05e5 \u05e9\u05d5\u05d1 \u05d5\u05e9\u05d5\u05d1. \u05e8\u05d9\u05e7 \u05d1\u05d4\u05ea\u05e8\u05d0\u05d5\u05ea \u05e9\u05d0\u05d9\u05e0\u05df \u05de\u05d1\u05d5\u05e1\u05e1\u05d5\u05ea-\u05d6\u05de\u05df."
    },
    "title": {
      "type": "string",
      "description": "\u05d4\u05db\u05d5\u05ea\u05e8\u05ea \u05e9\u05e0\u05e9\u05dc\u05d7\u05d4 \u05d1\u05e4\u05d5\u05e2\u05dc (\u05d0\u05d7\u05e8\u05d9 \u05d4\u05d7\u05dc\u05e4\u05ea \u05de\u05e9\u05ea\u05e0\u05d9\u05dd)"
    },
    "body": {
      "type": "string",
      "description": "\u05d4\u05d2\u05d5\u05e3 \u05e9\u05e0\u05e9\u05dc\u05d7 \u05d1\u05e4\u05d5\u05e2\u05dc"
    },
    "deep_link": {
      "type": "string",
      "description": "\u05d4\u05e0\u05ea\u05d9\u05d1 \u05e9\u05e0\u05e9\u05dc\u05d7"
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "skipped",
        "failed"
      ],
      "default": "sent",
      "description": "\u05ea\u05d5\u05e6\u05d0\u05ea \u05d4\u05e9\u05dc\u05d9\u05d7\u05d4: sent=\u05e0\u05e9\u05dc\u05d7, skipped=\u05e0\u05d3\u05d7\u05d4 (cooldown/\u05e1\u05d2\u05de\u05e0\u05d8), failed=\u05e9\u05d2\u05d9\u05d0\u05d4"
    },
    "skip_reason": {
      "type": "string",
      "description": "\u05e1\u05d9\u05d1\u05ea \u05d3\u05d7\u05d9\u05d9\u05d4 \u05d0\u05dd status=skipped"
    },
    "segment_matched": {
      "type": "string",
      "description": "\u05d4\u05e1\u05d2\u05de\u05e0\u05d8 \u05e9\u05d2\u05e8\u05dd \u05dc\u05e9\u05dc\u05d9\u05d7\u05d4 (\u05dc\u05e6\u05d5\u05e8\u05da \u05e0\u05d9\u05ea\u05d5\u05d7)"
    },
    "task_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e9\u05d9\u05de\u05d4 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9 \u05d0\u05dd \u05e7\u05d9\u05d9\u05dd"
    },
    "surface_brand_id": {
      "type": "string",
      "description": "Brand.id (ADR-23) of the surface the notification belonged to. Attribution only \u2014 notification delivery is unchanged. Nullable on pre-Package-4.3 records."
    }
  },
  "required": [
    "user_id",
    "event_key"
  ]
}