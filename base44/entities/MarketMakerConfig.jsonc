{
  "name": "MarketMakerConfig",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d0\u05d5\u05d8\u05d5\u05de\u05d8 \u05e4\u05e2\u05d9\u05dc. false = \u05d4-workflow \u05e8\u05e5 \u05d0\u05da \u05de\u05d3\u05dc\u05d2, \u05d5\u05d0\u05d9\u05df \u05e4\u05e8\u05e1\u05d5\u05dd \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9."
    },
    "interval_hours": {
      "type": "number",
      "default": 1,
      "description": "\u05db\u05dc \u05db\u05de\u05d4 \u05e9\u05e2\u05d5\u05ea \u05de\u05ea\u05d1\u05e6\u05e2 \u05de\u05d7\u05d6\u05d5\u05e8. \u05d4-workflow \u05e8\u05e5 \u05db\u05dc \u05e9\u05e2\u05d4 \u05d5\u05d4\u05de\u05d7\u05d6\u05d5\u05e8 \u05de\u05ea\u05d1\u05e6\u05e2 \u05e8\u05e7 \u05db\u05e9\u05e2\u05d1\u05e8 \u05e4\u05e8\u05e7 \u05d4\u05d6\u05de\u05df \u05d4\u05d6\u05d4."
    },
    "tasks_min": {
      "type": "number",
      "default": 5,
      "description": "\u05de\u05d9\u05e0\u05d9\u05de\u05d5\u05dd \u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05dc\u05e4\u05e8\u05e1\u05d5\u05dd \u05d1\u05de\u05d7\u05d6\u05d5\u05e8"
    },
    "tasks_max": {
      "type": "number",
      "default": 10,
      "description": "\u05de\u05e7\u05e1\u05d9\u05de\u05d5\u05dd \u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05dc\u05e4\u05e8\u05e1\u05d5\u05dd \u05d1\u05de\u05d7\u05d6\u05d5\u05e8"
    },
    "close_min": {
      "type": "number",
      "default": 1,
      "description": "\u05de\u05d9\u05e0\u05d9\u05de\u05d5\u05dd \u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05dc\u05e1\u05d2\u05d9\u05e8\u05d4 \u05d1\u05de\u05d7\u05d6\u05d5\u05e8 (\u05d4\u05d9\u05e9\u05e0\u05d5\u05ea \u05d1\u05d9\u05d5\u05ea\u05e8)"
    },
    "close_max": {
      "type": "number",
      "default": 3,
      "description": "\u05de\u05e7\u05e1\u05d9\u05de\u05d5\u05dd \u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05dc\u05e1\u05d2\u05d9\u05e8\u05d4 \u05d1\u05de\u05d7\u05d6\u05d5\u05e8"
    },
    "views_min": {
      "type": "number",
      "default": 5,
      "description": "\u05de\u05d9\u05e0\u05d9\u05de\u05d5\u05dd \u05e6\u05e4\u05d9\u05d5\u05ea \u05e9\u05e0\u05d5\u05e1\u05e4\u05d5\u05ea \u05dc\u05db\u05dc \u05de\u05e9\u05d9\u05de\u05d4 \u05d3\u05de\u05d5 \u05e4\u05ea\u05d5\u05d7\u05d4 \u05d1\u05de\u05d7\u05d6\u05d5\u05e8"
    },
    "views_max": {
      "type": "number",
      "default": 10,
      "description": "\u05de\u05e7\u05e1\u05d9\u05de\u05d5\u05dd \u05e6\u05e4\u05d9\u05d5\u05ea \u05e9\u05e0\u05d5\u05e1\u05e4\u05d5\u05ea \u05dc\u05db\u05dc \u05de\u05e9\u05d9\u05de\u05d4 \u05d3\u05de\u05d5 \u05e4\u05ea\u05d5\u05d7\u05d4 \u05d1\u05de\u05d7\u05d6\u05d5\u05e8"
    },
    "clicks_min": {
      "type": "number",
      "default": 1,
      "description": "\u05de\u05d9\u05e0\u05d9\u05de\u05d5\u05dd \u05db\u05e0\u05d9\u05e1\u05d5\u05ea \u05e9\u05e0\u05d5\u05e1\u05e4\u05d5\u05ea \u05dc\u05db\u05dc \u05de\u05e9\u05d9\u05de\u05d4 \u05d3\u05de\u05d5 \u05e4\u05ea\u05d5\u05d7\u05d4 \u05d1\u05de\u05d7\u05d6\u05d5\u05e8"
    },
    "clicks_max": {
      "type": "number",
      "default": 3,
      "description": "\u05de\u05e7\u05e1\u05d9\u05de\u05d5\u05dd \u05db\u05e0\u05d9\u05e1\u05d5\u05ea \u05e9\u05e0\u05d5\u05e1\u05e4\u05d5\u05ea \u05dc\u05db\u05dc \u05de\u05e9\u05d9\u05de\u05d4 \u05d3\u05de\u05d5 \u05e4\u05ea\u05d5\u05d7\u05d4 \u05d1\u05de\u05d7\u05d6\u05d5\u05e8"
    },
    "applicants_min": {
      "type": "number",
      "default": 1,
      "description": "\u05de\u05d9\u05e0\u05d9\u05de\u05d5\u05dd \u05de\u05d5\u05e2\u05de\u05d3\u05d9\u05dd \u05e9\u05de\u05ea\u05d5\u05d5\u05e1\u05e4\u05d9\u05dd \u05dc\u05de\u05e9\u05d9\u05de\u05d4 \u05e9\u05e0\u05d1\u05d7\u05e8\u05d4 \u05dc\u05e7\u05d1\u05dc \u05e4\u05e0\u05d9\u05d5\u05ea \u05d1\u05de\u05d7\u05d6\u05d5\u05e8"
    },
    "applicants_max": {
      "type": "number",
      "default": 2,
      "description": "\u05de\u05e7\u05e1\u05d9\u05de\u05d5\u05dd \u05de\u05d5\u05e2\u05de\u05d3\u05d9\u05dd \u05e9\u05de\u05ea\u05d5\u05d5\u05e1\u05e4\u05d9\u05dd \u05dc\u05de\u05e9\u05d9\u05de\u05d4 \u05e9\u05e0\u05d1\u05d7\u05e8\u05d4 \u05dc\u05e7\u05d1\u05dc \u05e4\u05e0\u05d9\u05d5\u05ea \u05d1\u05de\u05d7\u05d6\u05d5\u05e8"
    },
    "max_open_tasks": {
      "type": "number",
      "default": 60,
      "description": "\u05ea\u05e7\u05e8\u05d4 \u05dc\u05de\u05e1\u05e4\u05e8 \u05d4\u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05d4\u05d3\u05de\u05d5 \u05d4\u05e4\u05ea\u05d5\u05d7\u05d5\u05ea. \u05de\u05e2\u05dc\u05d9\u05d4 \u05d4\u05de\u05d7\u05d6\u05d5\u05e8 \u05de\u05e4\u05e1\u05d9\u05e7 \u05dc\u05e4\u05e8\u05e1\u05dd \u05db\u05d3\u05d9 \u05e9\u05d4\u05e4\u05d9\u05d3 \u05dc\u05d0 \u05d9\u05d5\u05e6\u05e3."
    },
    "min_price": {
      "type": "number",
      "default": 100
    },
    "max_price": {
      "type": "number",
      "default": 2000
    },
    "cities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d4\u05e2\u05e8\u05d9\u05dd \u05e9\u05d4\u05d0\u05d5\u05d8\u05d5\u05de\u05d8 \u05de\u05e4\u05e8\u05e1\u05dd \u05d1\u05d4\u05df. \u05e8\u05d9\u05e7 = \u05ea\u05dc \u05d0\u05d1\u05d9\u05d1."
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05e4\u05ea\u05d7\u05d5\u05ea \u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05de\u05d4\u05e7\u05d8\u05dc\u05d5\u05d2 \u05d4\u05d2\u05dc\u05d5\u05d1\u05dc\u05d9. \u05e8\u05d9\u05e7 = \u05db\u05dc \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d5\u05ea \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea."
    },
    "brand_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d4\u05de\u05d5\u05ea\u05d2\u05d9\u05dd \u05e9\u05d0\u05dc\u05d9\u05d4\u05dd \u05d9\u05d9\u05d5\u05d7\u05e1\u05d5 \u05d4\u05de\u05e9\u05d9\u05de\u05d5\u05ea. \u05e8\u05d9\u05e7 = \u05d4\u05de\u05d5\u05ea\u05d2 \u05d4\u05de\u05d5\u05d1\u05dc\u05e2 \u05e9\u05dc \u05d4\u05e4\u05dc\u05d8\u05e4\u05d5\u05e8\u05de\u05d4."
    },
    "last_run_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05d1\u05d5\u05e6\u05e2 \u05de\u05d7\u05d6\u05d5\u05e8 \u05dc\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4"
    },
    "last_run_summary": {
      "type": "object",
      "additionalProperties": true,
      "description": "\u05e1\u05d9\u05db\u05d5\u05dd \u05d4\u05de\u05d7\u05d6\u05d5\u05e8 \u05d4\u05d0\u05d7\u05e8\u05d5\u05df \u2014 \u05db\u05de\u05d4 \u05e4\u05d5\u05e8\u05e1\u05de\u05d5, \u05db\u05de\u05d4 \u05e0\u05e1\u05d2\u05e8\u05d5 \u05d5\u05db\u05de\u05d4 \u05e6\u05e4\u05d9\u05d5\u05ea/\u05e4\u05e0\u05d9\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}