{
  "name": "GlobalCategory",
  "type": "object",
  "properties": {
    "category_key": {
      "type": "string",
      "description": "Immutable global key. Existing Task enum keys remain unchanged; additional service keys are persisted in Task.category_details.brand_category_key."
    },
    "label": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "parent_key": {
      "type": "string",
      "description": "GlobalCategory.category_key of the parent, empty for roots. Supports future deeper nesting."
    },
    "node_type": {
      "type": "string",
      "enum": [
        "parent",
        "service"
      ],
      "default": "service"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "fields": {
      "type": "array",
      "description": "Single global task form for an actionable service; never copied into a Brand.",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "textarea",
              "number",
              "select",
              "multiselect",
              "boolean",
              "date",
              "time"
            ],
            "default": "text"
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "order": {
            "type": "number",
            "default": 0
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "validation": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "key"
        ]
      }
    }
  },
  "required": [
    "category_key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}