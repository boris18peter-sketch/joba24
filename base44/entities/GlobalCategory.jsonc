{
  "name": "GlobalCategory",
  "type": "object",
  "properties": {
    "category_key": {
      "type": "string",
      "description": "Stable machine key. Matches the platform Task.category enum for a platform category, or a new global key (which is persisted on a Task as category 'other' with the key kept in category_details.brand_category_key). Unique across the platform."
    },
    "label": {
      "type": "string",
      "description": "Display name of the category across every Brand. A Brand may override the label for itself only (BrandCategory.label)."
    },
    "icon": {
      "type": "string",
      "description": "Emoji or icon key shown in the category picker."
    },
    "description": {
      "type": "string",
      "description": "Short explanation shown to the publisher when choosing this category."
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Default position in the category list. A Brand may reorder its own list (BrandCategory.sort_order)."
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this category is offered anywhere on the platform. Inactive removes it from every Brand."
    },
    "fields": {
      "type": "array",
      "description": "THE GLOBAL TASK FORM for this category. One definition, shared by every Brand that uses the category \u2014 improving it here improves it everywhere. A Brand never owns a copy.",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Stable field key, stored on the Task in category_details."
          },
          "label": {
            "type": "string",
            "description": "Question shown to the publisher."
          },
          "description": {
            "type": "string",
            "description": "Helper text under the field."
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "textarea",
              "number",
              "select",
              "multiselect",
              "boolean",
              "date",
              "time"
            ],
            "default": "text"
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "order": {
            "type": "number",
            "default": 0
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Choices for select / multiselect fields."
          },
          "validation": {
            "type": "object",
            "additionalProperties": true,
            "description": "Optional constraints, e.g. { min, max, min_length, max_length, pattern }."
          }
        },
        "required": [
          "key"
        ]
      }
    }
  },
  "required": [
    "category_key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}