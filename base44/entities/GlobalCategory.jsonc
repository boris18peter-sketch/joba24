{
  "name": "GlobalCategory",
  "type": "object",
  "properties": {
    "category_key": {
      "type": "string",
      "description": "Immutable global key. Never renamed \u2014 existing Task.category values stay valid."
    },
    "label": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "parent_key": {
      "type": "string",
      "description": "Canonical taxonomy parent (GlobalCategory.category_key). Empty for root nodes. A VISUAL GROUP must never appear here \u2014 that is group_key's job."
    },
    "group_key": {
      "type": "string",
      "description": "VISUAL GROUP only (a node_type='group' row's category_key). Purely presentational: it lets broad UIs organise roots into sections. It is never persisted as a Task's professional category and never used for matching."
    },
    "node_type": {
      "type": "string",
      "enum": [
        "group",
        "root",
        "service",
        "parent"
      ],
      "default": "service",
      "description": "group (was 'parent') = visual section only, never a task category. root = a niche/root category a Brand can be built around. service = an actionable category that owns a global task form."
    },
    "is_niche": {
      "type": "boolean",
      "default": false,
      "description": "True for roots that are strong enough to be a Brand's entire niche (Plumbing, Events...). Purely a curation hint for Brand Studio \u2014 the mechanism itself works for ANY root."
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "description_example": {
      "type": "string",
      "description": "The task-description placeholder shown when THIS actionable category is selected. Global content shared by every Brand that offers the category."
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Short example task titles for THIS actionable category, used by the brand-aware content layer (homepage, empty states, search, onboarding). Global content \u2014 never duplicated per Brand."
    },
    "helper_copy": {
      "type": "string",
      "description": "Optional helper/microcopy for this category (chips, hints, CTA support text)."
    },
    "status_flow": {
      "type": "object",
      "additionalProperties": true,
      "description": "GLOBAL, category-aware lifecycle PRESENTATION. The backend states are fixed (worker_status: on_the_way \u2192 arrived \u2192 done); this object only renames them per service so a DJ does not read like a plumber. Shape: { steps: [{key,label,owner_label,icon}], cta: { <key>: {label,emoji,confirm_title,confirm_sub,toast} }, proof: {label,sub} }. Any unset field inherits the generic fallback. Defined once globally \u2014 every Brand offering this category gets it."
    },
    "fields": {
      "type": "array",
      "description": "The single global task form for an actionable service; never copied into a Brand. A subcategory INHERITS its root's fields (see globalFormFields), so a root holds only questions common to every service beneath it.",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "textarea",
              "number",
              "select",
              "multiselect",
              "boolean",
              "date",
              "time"
            ],
            "default": "text"
          },
          "required": {
            "type": "boolean",
            "default": false
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "order": {
            "type": "number",
            "default": 0
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "validation": {
            "type": "object",
            "additionalProperties": true
          },
          "showWhen": {
            "type": "object",
            "description": "DECLARATIVE condition \u2014 the field is shown only while it holds. Exactly ONE operator, keyed off another field in the same resolved form. Sanitized on write by sanitizeShowWhen; anything outside this shape is dropped, so no executable logic can be stored.",
            "properties": {
              "field": {
                "type": "string",
                "description": "The key of the field this condition reads (e.g. water_flow)."
              },
              "equals": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ],
                "description": "Show when the source value equals this scalar."
              },
              "notEquals": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ],
                "description": "Show when the source value differs from this scalar."
              },
              "in": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "description": "Show when the source value is one of these scalars."
              },
              "notIn": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "description": "Show when the source value is none of these scalars."
              }
            },
            "required": [
              "field"
            ]
          }
        },
        "required": [
          "key"
        ]
      }
    }
  },
  "required": [
    "category_key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}