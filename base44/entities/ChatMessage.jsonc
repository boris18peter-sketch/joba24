{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string"
    },
    "sender_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "thread_key": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d4\u05ea\u05db\u05ea\u05d1\u05d5\u05ea \u2014 \u05e9\u05e0\u05d9 \u05d4\u05de\u05e9\u05ea\u05ea\u05e4\u05d9\u05dd \u05de\u05de\u05d5\u05d9\u05e0\u05d9\u05dd \u05d5\u05de\u05d7\u05d5\u05d1\u05e8\u05d9\u05dd \u05d1-__. \u05db\u05da \u05db\u05dc \u05de\u05d5\u05e2\u05de\u05d3 \u05de\u05e7\u05d1\u05dc \u05e9\u05d9\u05d7\u05d4 \u05e0\u05e4\u05e8\u05d3\u05ea \u05e2\u05dd \u05d4\u05de\u05e4\u05e8\u05e1\u05dd \u05d5\u05dc\u05d0 \u05e8\u05d5\u05d0\u05d4 \u05d4\u05d5\u05d3\u05e2\u05d5\u05ea \u05e9\u05dc \u05de\u05d5\u05e2\u05de\u05d3\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd."
    },
    "recipient_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e0\u05de\u05e2\u05df \u05e9\u05dc \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4 \u2014 \u05d4\u05d0\u05d3\u05dd \u05e9\u05d0\u05dc\u05d9\u05d5 \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4 \u05e0\u05e9\u05dc\u05d7\u05d4 \u05d1\u05e4\u05d5\u05e2\u05dc."
    },
    "surface_brand_id": {
      "type": "string",
      "description": "Brand.id (ADR-23) of the surface the conversation happened on. Attribution and cross-Brand merge protection \u2014 a conversation can never be joined across Brands. Nullable on pre-Package-4.3 records."
    }
  },
  "required": [
    "task_id",
    "sender_id",
    "content"
  ]
}