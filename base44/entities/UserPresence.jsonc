{
  "name": "UserPresence",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    },
    "is_online": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}