{
  "name": "NotificationConfig",
  "type": "object",
  "properties": {
    "event_key": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05dc\u05d0\u05d9\u05e8\u05d5\u05e2 (\u05dc\u05d3\u05d5\u05d2\u05de\u05d4: application_created, verification_approved_green, daily_earnings_summary)"
    },
    "event_label": {
      "type": "string",
      "description": "\u05e9\u05dd \u05ea\u05e6\u05d5\u05d2\u05d4 \u05d1\u05e2\u05d1\u05e8\u05d9\u05ea"
    },
    "category": {
      "type": "string",
      "enum": [
        "transactional",
        "achievement",
        "engagement",
        "retention",
        "monetization",
        "trust"
      ],
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05ea\u05e8\u05d0\u05d4 \u05dc\u05e6\u05d5\u05e8\u05da \u05d0\u05e8\u05d2\u05d5\u05df \u05d1\u05d3\u05e9\u05d1\u05d5\u05e8\u05d3"
    },
    "title_template": {
      "type": "string",
      "description": "\u05ea\u05d1\u05e0\u05d9\u05ea \u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05d4\u05ea\u05e8\u05d0\u05d4. \u05ea\u05d5\u05de\u05da \u05d1\u05de\u05e9\u05ea\u05e0\u05d9\u05dd: {worker_name}, {client_name}, {task_title}, {amount}, {count}, {category}, {rating}"
    },
    "body_template": {
      "type": "string",
      "description": "\u05ea\u05d1\u05e0\u05d9\u05ea \u05d2\u05d5\u05e3 \u05d4\u05d4\u05ea\u05e8\u05d0\u05d4. \u05ea\u05d5\u05de\u05da \u05d1\u05d0\u05d5\u05ea\u05dd \u05de\u05e9\u05ea\u05e0\u05d9\u05dd."
    },
    "deep_link": {
      "type": "string",
      "description": "\u05e0\u05ea\u05d9\u05d1 \u05e0\u05d9\u05d5\u05d5\u05d8 \u05d1\u05dc\u05d7\u05d9\u05e6\u05d4. \u05ea\u05d5\u05de\u05da \u05d1\u05de\u05e9\u05ea\u05e0\u05d9\u05dd: {task_id}, {user_id}"
    },
    "tag_template": {
      "type": "string",
      "default": "joba24",
      "description": "\u05ea\u05d2\u05d9\u05ea FCM \u05dc\u05e7\u05d9\u05d1\u05d5\u05e5 \u05d4\u05ea\u05e8\u05d0\u05d5\u05ea. \u05ea\u05d5\u05de\u05da \u05d1\u05de\u05e9\u05ea\u05e0\u05d9\u05dd: {task_id}, {worker_id}"
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "all",
          "verified_green",
          "verified_gold",
          "unverified",
          "new_user",
          "experienced_worker",
          "active_poster",
          "low_balance",
          "no_applications_approved",
          "agent",
          "agent_active",
          "agent_inactive"
        ]
      },
      "default": [
        "all"
      ],
      "description": "\u05e1\u05d2\u05de\u05e0\u05d8\u05e6\u05d9\u05d9\u05ea \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05e9\u05de\u05e7\u05d1\u05dc\u05d9\u05dd \u05d0\u05ea \u05d4\u05d4\u05ea\u05e8\u05d0\u05d4. 'all' = \u05db\u05d5\u05dc\u05dd. \u05e1\u05d5\u05db\u05e0\u05d9\u05dd: agent, agent_active, agent_inactive"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05ea\u05e8\u05d0\u05d4 \u05d6\u05d5 \u05e4\u05e2\u05d9\u05dc\u05d4"
    },
    "cooldown_minutes": {
      "type": "number",
      "default": 0,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d3\u05e7\u05d5\u05ea \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05d1\u05d9\u05df \u05d4\u05ea\u05e8\u05d0\u05d5\u05ea \u05de\u05d0\u05d5\u05ea\u05d5 \u05e1\u05d5\u05d2 \u05dc\u05d0\u05d5\u05ea\u05d5 \u05de\u05e9\u05ea\u05de\u05e9. 0 = \u05dc\u05dc\u05d0 \u05d4\u05d2\u05d1\u05dc\u05d4."
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ],
      "default": "normal"
    },
    "send_email": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05dc\u05e9\u05dc\u05d5\u05d7 \u05d2\u05dd \u05d0\u05d9\u05de\u05d9\u05d9\u05dc (\u05dc\u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05e8\u05e9\u05d5\u05de\u05d9\u05dd \u05d1\u05dc\u05d1\u05d3)"
    },
    "email_subject_template": {
      "type": "string",
      "description": "\u05e0\u05d5\u05e9\u05d0 \u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05d0\u05dd send_email=true"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "\u05e1\u05d3\u05e8 \u05ea\u05e6\u05d5\u05d2\u05d4 \u05d1\u05d3\u05e9\u05d1\u05d5\u05e8\u05d3"
    }
  },
  "required": [
    "event_key",
    "event_label",
    "title_template",
    "body_template"
  ]
}