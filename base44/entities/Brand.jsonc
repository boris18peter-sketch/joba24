{
  "name": "Brand",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "description": "Unique stable Brand slug."
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "archived"
      ],
      "default": "active"
    },
    "origin": {
      "type": "string",
      "enum": [
        "platform",
        "partner"
      ],
      "default": "platform"
    },
    "is_default": {
      "type": "boolean",
      "default": false
    },
    "category_model_version": {
      "type": "number",
      "description": "2 selects parent inheritance. Unset preserves legacy reads during migration."
    },
    "assigned_parent_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Assigned global parent categories. Their active descendant services are inherited dynamically."
    },
    "excluded_child_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional global service exclusions for this Brand only. No form copies."
    }
  },
  "required": [
    "slug",
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}