{
  "name": "Brand",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05d5\u05d9\u05e6\u05d9\u05d1 \u05e9\u05dc \u05d4\u05de\u05d5\u05ea\u05d2 (\u05dc\u05de\u05e9\u05dc: joba24, events, pets). \u05d0\u05d9\u05e0\u05d5 \u05e0\u05d9\u05ea\u05df \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9 \u05dc\u05d0\u05d7\u05e8 \u05d4\u05d9\u05e6\u05d9\u05e8\u05d4."
    },
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d5\u05ea\u05d2 \u05dc\u05ea\u05e6\u05d5\u05d2\u05d4."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "archived"
      ],
      "default": "active",
      "description": "\u05de\u05e6\u05d1 \u05de\u05d7\u05d6\u05d5\u05e8 \u05d4\u05d7\u05d9\u05d9\u05dd \u05e9\u05dc \u05d4\u05de\u05d5\u05ea\u05d2."
    },
    "origin": {
      "type": "string",
      "enum": [
        "platform",
        "partner"
      ],
      "default": "platform",
      "description": "platform = \u05de\u05d5\u05ea\u05d2 \u05d4\u05d1\u05d9\u05ea \u05e9\u05dc \u05d4\u05e4\u05dc\u05d8\u05e4\u05d5\u05e8\u05de\u05d4, partner = \u05de\u05d5\u05ea\u05d2 \u05e9\u05d5\u05ea\u05e3."
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d6\u05d4\u05d5 \u05de\u05d5\u05ea\u05d2 \u05d1\u05e8\u05d9\u05e8\u05ea \u05d4\u05de\u05d7\u05d3\u05dc \u05e9\u05dc \u05d4\u05e4\u05dc\u05d8\u05e4\u05d5\u05e8\u05de\u05d4. \u05de\u05d5\u05ea\u05d2 \u05d0\u05d7\u05d3 \u05d1\u05dc\u05d1\u05d3 \u05d0\u05de\u05d5\u05e8 \u05dc\u05d4\u05d9\u05d5\u05ea true."
    }
  },
  "required": [
    "slug",
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}