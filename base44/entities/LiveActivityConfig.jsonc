{
  "name": "LiveActivityConfig",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "MASTER FLAG for SENDING. false = no snapshot is dispatched and no network call is made. Shipped false, and stays false until Stage 3 is separately approved."
    },
    "dry_run": {
      "type": "boolean",
      "default": true,
      "description": "true = the sender computes and records what it WOULD send, but never contacts APNs. Only an explicit false, together with enabled=true, permits a real push."
    },
    "diagnostic_events": {
      "type": "boolean",
      "default": false,
      "description": "STAGE 2 SWITCH. true = real Task events are observed and recorded as diagnostic rows. Independent of `enabled`: observation never sends, and sending never records observations."
    },
    "diagnostic_retention_days": {
      "type": "number",
      "default": 7,
      "description": "How many days of diagnostic rows to keep. Rows older than this are swept on the next recorded observation. Capped at 30 server-side."
    },
    "track_open_publisher": {
      "type": "boolean",
      "default": true,
      "description": "Allow OPEN tasks to be tracked for their publisher."
    },
    "track_taken_publisher": {
      "type": "boolean",
      "default": true,
      "description": "Allow TAKEN tasks to be tracked for their publisher."
    },
    "track_taken_worker": {
      "type": "boolean",
      "default": true,
      "description": "Allow TAKEN tasks to be tracked for the assigned worker."
    },
    "environment": {
      "type": "string",
      "enum": [
        "development",
        "production"
      ],
      "default": "development",
      "description": "Which APNs environment dispatches may target. Tokens registered for a different environment are skipped, never cross-sent."
    },
    "max_tokens_per_dispatch": {
      "type": "number",
      "default": 20,
      "description": "Safety bound on how many device tokens one dispatch may address."
    },
    "updated_by": {
      "type": "string",
      "description": "Who last changed the flag."
    },
    "note": {
      "type": "string",
      "description": "Free-text operator note, e.g. why the flag was flipped."
    }
  },
  "required": [],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}