{
  "name": "LiveActivityConfig",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false,
      "description": "MASTER FLAG for SENDING, for EVERY user. false = no snapshot is dispatched and no network call is made. Test-mode recipients are governed separately by test_user_ids/test_apns and never depend on this flag."
    },
    "dry_run": {
      "type": "boolean",
      "default": true,
      "description": "true = the sender computes and records what it WOULD send, but never contacts APNs. Only an explicit false, together with enabled=true, permits a real push to a non-test user."
    },
    "test_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "RESTRICTED REAL-TASK TEST MODE. User ids explicitly allowlisted to receive real-task Live Activities (start/update/end) while the global pipeline stays off. An empty list means the real-task path is completely inert for everyone. Max 20 ids, trimmed server-side."
    },
    "test_apns": {
      "type": "boolean",
      "default": false,
      "description": "Real APNs delivery FOR THE ALLOWLISTED test users only. Only a literal true permits a network call, and only for a recipient listed in test_user_ids. It can never arm delivery for anybody else, and it never overrides `dry_run` for non-test users."
    },
    "android_delivery": {
      "type": "boolean",
      "default": false,
      "description": "ANDROID TRANSPORT SWITCH. true = the same snapshot revision is also delivered to the recipient's Android devices as a data-only FCM message, which the app renders as an ongoing notification and promotes to an Android 16 Live Update where the device supports it. Completely independent of APNs: arming iOS never arms Android and vice versa. Android has no Push-to-Start equivalent, so a data message may create the card while the app is closed."
    },
    "push_to_start": {
      "type": "boolean",
      "default": false,
      "description": "PUSH-TO-START SWITCH (iOS 17.2+). true = a task becoming active may make a card APPEAR on an allowlisted user's Lock Screen while the app is closed, instead of waiting for the app to open. Only a literal true arms it, and it can never widen the allowlist: delivery still requires isTestUser + test_apns. false = a card can only ever be started by the app itself."
    },
    "diagnostic_events": {
      "type": "boolean",
      "default": false,
      "description": "STAGE 2 SWITCH. true = real Task events are observed and recorded as diagnostic rows. Independent of `enabled`: observation never sends, and sending never records observations."
    },
    "diagnostic_retention_days": {
      "type": "number",
      "default": 7,
      "description": "How many days of diagnostic rows to keep. Rows older than this are swept on the next recorded observation. Capped at 30 server-side."
    },
    "track_open_publisher": {
      "type": "boolean",
      "default": true,
      "description": "Allow OPEN tasks to be tracked for their publisher."
    },
    "track_taken_publisher": {
      "type": "boolean",
      "default": true,
      "description": "Allow TAKEN tasks to be tracked for their publisher."
    },
    "track_taken_worker": {
      "type": "boolean",
      "default": true,
      "description": "Allow TAKEN tasks to be tracked for the assigned worker."
    },
    "environment": {
      "type": "string",
      "enum": [
        "development",
        "production"
      ],
      "default": "development",
      "description": "Which APNs environment dispatches may target. Tokens registered for a different environment are skipped, never cross-sent. A TestFlight build registers production tokens; an Xcode/debug build registers sandbox tokens."
    },
    "max_tokens_per_dispatch": {
      "type": "number",
      "default": 20,
      "description": "Safety bound on how many device tokens one dispatch may address."
    },
    "updated_by": {
      "type": "string",
      "description": "Who last changed the flag."
    },
    "note": {
      "type": "string",
      "description": "Free-text operator note, e.g. why the flag was flipped."
    }
  },
  "required": [],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}