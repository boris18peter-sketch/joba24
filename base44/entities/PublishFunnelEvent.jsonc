{
  "name": "PublishFunnelEvent",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d0\u05e0\u05d5\u05e0\u05d9\u05de\u05d9 \u05e9\u05dc \u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05e4\u05e8\u05e1\u05d5\u05dd \u05d0\u05d7\u05d3. \u05e0\u05d5\u05e6\u05e8 \u05d1\u05d3\u05e4\u05d3\u05e4\u05df \u05d5\u05e0\u05e9\u05de\u05e8 \u05dc-session, \u05db\u05da \u05e9\u05db\u05dc \u05de\u05d9 \u05e9\u05e0\u05db\u05e0\u05e1 \u05dc\u05d8\u05d5\u05e4\u05e1 \u05de\u05e7\u05d1\u05dc \u05e9\u05d5\u05e8\u05d4 \u05de\u05e9\u05dc\u05d5 \u05d2\u05dd \u05d1\u05dc\u05d9 \u05dc\u05d4\u05ea\u05d7\u05d1\u05e8. \u05e9\u05d5\u05e8\u05d4 \u05d0\u05d7\u05ea = \u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05d0\u05d7\u05d3."
    },
    "user_id": {
      "type": "string",
      "description": "\u05e0\u05e7\u05e9\u05e8 \u05dc\u05d7\u05e9\u05d1\u05d5\u05df \u05d1\u05e8\u05d2\u05e2 \u05e9\u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05de\u05ea\u05d7\u05d1\u05e8 \u05ea\u05d5\u05da \u05db\u05d3\u05d9 \u05d4\u05ea\u05d4\u05dc\u05d9\u05da. \u05e8\u05d9\u05e7 = \u05d4\u05ea\u05d7\u05d9\u05dc \u05d5\u05dc\u05d0 \u05d4\u05ea\u05d7\u05d1\u05e8 \u05de\u05e2\u05d5\u05dc\u05dd (\u05d4\u05e0\u05e9\u05d9\u05e8\u05d4 \u05d4\u05d2\u05d3\u05d5\u05dc\u05d4 \u05d1\u05e7\u05de\u05e4\u05d9\u05df)."
    },
    "user_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d4\u05de\u05d7\u05d5\u05d1\u05e8 \u05d1\u05e2\u05ea \u05e8\u05d9\u05e9\u05d5\u05dd \u05d4\u05e9\u05dc\u05d1. \u05e0\u05e9\u05de\u05e8 \u05d1\u05e8\u05d2\u05e2 \u05d4\u05d4\u05ea\u05d7\u05d1\u05e8\u05d5\u05ea \u05db\u05d3\u05d9 \u05e9\u05e0\u05d9\u05ea\u05df \u05d9\u05d4\u05d9\u05d4 \u05dc\u05d6\u05d4\u05d5\u05ea \u05de\u05d9 \u05e2\u05d5\u05de\u05d3 \u05de\u05d0\u05d7\u05d5\u05e8\u05d9 \u05d4\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05d1\u05dc\u05d9 \u05dc\u05d7\u05e4\u05e9 \u05d9\u05d3\u05e0\u05d9\u05ea. \u05e8\u05d9\u05e7 \u05d0\u05e6\u05dc \u05d0\u05d5\u05e8\u05d7\u05d9\u05dd \u05d5\u05dc\u05e9\u05d5\u05e8\u05d5\u05ea \u05e9\u05e0\u05e8\u05e9\u05de\u05d5 \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d4\u05e9\u05d3\u05d4 \u05e0\u05d5\u05e1\u05e3."
    },
    "user_email": {
      "type": "string",
      "description": "\u05d4\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d4\u05de\u05d7\u05d5\u05d1\u05e8 \u2014 \u05de\u05d6\u05d4\u05d4 \u05de\u05e9\u05e0\u05d9 \u05db\u05e9\u05d9\u05e9 \u05e9\u05e0\u05d9 \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05d1\u05d0\u05d5\u05ea\u05d5 \u05e9\u05dd."
    },
    "furthest_step": {
      "type": "string",
      "enum": [
        "opened",
        "category",
        "details",
        "location",
        "pricing",
        "contact",
        "ready",
        "published"
      ],
      "default": "opened",
      "description": "\u05d4\u05e9\u05dc\u05d1 \u05d4\u05e8\u05d7\u05d5\u05e7 \u05d1\u05d9\u05d5\u05ea\u05e8 \u05e9\u05d0\u05dc\u05d9\u05d5 \u05d4\u05d2\u05d9\u05e2 \u05d4\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05d4\u05d6\u05d4. \u05d6\u05d4 \u05d4\u05e9\u05d3\u05d4 \u05e9\u05de\u05e8\u05d0\u05d4 \u05d0\u05d9\u05e4\u05d4 \u05db\u05dc \u05d0\u05d7\u05d3 \u05e2\u05e6\u05e8. \u05dc\u05e2\u05d5\u05dc\u05dd \u05dc\u05d0 \u05e0\u05e1\u05d5\u05d2 \u05d0\u05d7\u05d5\u05e8\u05d4."
    },
    "furthest_step_index": {
      "type": "number",
      "default": 0,
      "description": "\u05d4\u05d0\u05d9\u05e0\u05d3\u05e7\u05e1 \u05d4\u05de\u05e1\u05e4\u05e8\u05d9 \u05e9\u05dc furthest_step (0=opened \u2026 7=published). \u05de\u05d0\u05e4\u05e9\u05e8 \u05dc\u05e1\u05e4\u05d5\u05e8 \u05db\u05de\u05d4 \u05d4\u05d2\u05d9\u05e2\u05d5 \u05dc\u05db\u05dc \u05e9\u05dc\u05d1 \u05d1\u05dc\u05d9 \u05dc\u05e4\u05e2\u05e0\u05d7 \u05de\u05d7\u05e8\u05d5\u05d6\u05d5\u05ea."
    },
    "steps_reached": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05db\u05dc \u05d4\u05e9\u05dc\u05d1\u05d9\u05dd \u05e9\u05e0\u05e6\u05e4\u05d5 \u05d1\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05d4\u05d6\u05d4, \u05d2\u05dd \u05d0\u05dd \u05e2\u05d1\u05e8\u05d5 \u05d0\u05d5\u05ea\u05dd \u05d1\u05e1\u05d3\u05e8 \u05e9\u05d5\u05e0\u05d4."
    },
    "source_track": {
      "type": "string",
      "description": "\u05d4\u05e7\u05de\u05e4\u05d9\u05d9\u05df \u05e9\u05de\u05de\u05e0\u05d5 \u05d4\u05d2\u05d9\u05e2 (?track=publish \u05d1\u05e7\u05d9\u05e9\u05d5\u05e8). \u05e8\u05d9\u05e7 = \u05db\u05e0\u05d9\u05e1\u05d4 \u05d0\u05d5\u05e8\u05d2\u05e0\u05d9\u05ea."
    },
    "category": {
      "type": "string",
      "description": "\u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05e9\u05e0\u05d1\u05d7\u05e8\u05d4, \u05d0\u05dd \u05e0\u05d1\u05d7\u05e8\u05d4."
    },
    "city": {
      "type": "string",
      "description": "\u05d4\u05e2\u05d9\u05e8 \u05e9\u05d4\u05d5\u05d6\u05e0\u05d4, \u05d0\u05dd \u05d4\u05d5\u05d6\u05e0\u05d4."
    },
    "has_account": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05d4\u05d2\u05d9\u05e2 \u05de\u05de\u05d9 \u05e9\u05d9\u05e9 \u05dc\u05d5 \u05d7\u05e9\u05d1\u05d5\u05df. false \u05dc\u05d0\u05d5\u05e8\u05da \u05db\u05dc \u05d4\u05ea\u05d4\u05dc\u05d9\u05da = \u05e0\u05e9\u05e8 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d4\u05ea\u05d7\u05d1\u05e8\u05d5\u05ea."
    },
    "published_task_id": {
      "type": "string",
      "description": "\u05d4\u05de\u05e9\u05d9\u05de\u05d4 \u05e9\u05e4\u05d5\u05e8\u05e1\u05de\u05d4, \u05d0\u05dd \u05d4\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05d4\u05e1\u05ea\u05d9\u05d9\u05dd \u05d1\u05e4\u05e8\u05e1\u05d5\u05dd. \u05e8\u05d9\u05e7 = \u05dc\u05d0 \u05e4\u05d5\u05e8\u05e1\u05dd."
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05d4\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05d4\u05ea\u05d7\u05d9\u05dc"
    },
    "last_seen_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05e0\u05e8\u05e9\u05de\u05d4 \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05d1\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05d4\u05d6\u05d4"
    }
  },
  "required": [
    "session_id",
    "furthest_step"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}