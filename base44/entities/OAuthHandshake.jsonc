{
  "name": "OAuthHandshake",
  "type": "object",
  "properties": {
    "sid": {
      "type": [
        "string",
        "null"
      ],
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d7\u05d9\u05d1\u05d5\u05e8 \u05d7\u05d3-\u05e4\u05e2\u05de\u05d9 \u05e9\u05de\u05e9\u05de\u05e9 \u05dc\u05d4\u05e2\u05d1\u05e8\u05ea \u05d8\u05d5\u05e7\u05df OAuth \u05de\u05d4\u05d3\u05e4\u05d3\u05e4\u05df \u05d4\u05d7\u05d9\u05e6\u05d5\u05e0\u05d9 \u05dc\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05d4\u05e0\u05d9\u05d9\u05d8\u05d9\u05d1\u05d9\u05ea. null \u05db\u05e9\u05d4-backend \u05d4\u05e9\u05d9\u05e8 \u05d0\u05ea \u05d4-sid \u05de-from_url \u2014 \u05d0\u05d6 \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05de\u05d5\u05e6\u05d0\u05ea \u05d0\u05ea \u05d4\u05d8\u05d5\u05e7\u05df \u05dc\u05e4\u05d9 \u05d4\u05e8\u05e9\u05d5\u05de\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4."
    },
    "token": {
      "type": "string",
      "description": "\u05d8\u05d5\u05e7\u05df \u05d4\u05d2\u05d9\u05e9\u05d4 (access_token) \u05e9\u05d4\u05d5\u05d7\u05d6\u05e8 \u05de\u05e1\u05e4\u05e7 \u05d4-OAuth"
    }
  },
  "required": [
    "token"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}