{
  "name": "IosPurchase",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d1\u05d9\u05e6\u05e2 \u05d0\u05ea \u05d4\u05e8\u05db\u05d9\u05e9\u05d4"
    },
    "product_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05d5\u05e6\u05e8 (IAP) \u05db\u05e4\u05d9 \u05e9\u05d4\u05d5\u05d2\u05d3\u05e8 \u05d1-App Store Connect"
    },
    "credits": {
      "type": "number",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05d2'\u05d5\u05d1\u05d5\u05ea \u05e9\u05e0\u05d5\u05e1\u05e4\u05d5 \u05dc\u05d9\u05ea\u05e8\u05d4 (0 \u05d1\u05e8\u05e9\u05d5\u05de\u05ea \u05db\u05e9\u05dc \u2014 \u05dc\u05e6\u05d5\u05e8\u05db\u05d9 observability)"
    },
    "transaction_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e2\u05e1\u05e7\u05d4 \u05e9\u05dc Apple \u2014 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9, \u05de\u05e9\u05de\u05e9 \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05d6\u05d9\u05db\u05d5\u05d9 \u05db\u05e4\u05d5\u05dc. \u05d7\u05e1\u05e8 \u05d1\u05e8\u05e9\u05d5\u05de\u05d5\u05ea \u05db\u05e9\u05dc."
    },
    "original_transaction_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e2\u05e1\u05e7\u05d4 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9\u05ea \u05e9\u05dc Apple (\u05de\u05d6\u05d4\u05d4 \u05d0\u05ea \u05d4\u05de\u05e0\u05d5\u05d9 \u05dc\u05d0\u05d5\u05e8\u05da \u05db\u05dc \u05ea\u05e7\u05d5\u05e4\u05d5\u05ea \u05d4\u05d7\u05d9\u05d5\u05d1)"
    },
    "environment": {
      "type": "string",
      "enum": [
        "Sandbox",
        "Production"
      ],
      "description": "\u05e1\u05d1\u05d9\u05d1\u05ea \u05d4\u05e8\u05db\u05d9\u05e9\u05d4 \u2014 Sandbox (\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea) \u05d0\u05d5 Production"
    },
    "purchase_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05d5\u05e2\u05d3 \u05d4\u05e8\u05db\u05d9\u05e9\u05d4"
    },
    "expiration_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "\u05ea\u05d5\u05e7\u05e3 \u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05de\u05e0\u05d5\u05d9 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9\u05ea \u2014 \u05dc\u05de\u05d5\u05e6\u05e8\u05d9 \u05de\u05e0\u05d5\u05d9 \u05d1\u05dc\u05d1\u05d3"
    },
    "status": {
      "type": "string",
      "enum": [
        "verified",
        "refunded",
        "revoked",
        "expired",
        "cancelled",
        "failed_verification",
        "failed_entitlement"
      ],
      "default": "verified",
      "description": "\u05de\u05e6\u05d1 \u05d4\u05d6\u05db\u05d5\u05ea. failed_* \u05e0\u05db\u05ea\u05d1 \u05e8\u05e7 \u05dc\u05e6\u05d5\u05e8\u05db\u05d9 observability \u05d5\u05d0\u05d9\u05e0\u05d5 \u05de\u05d9\u05d9\u05e6\u05d2 \u05d6\u05db\u05d5\u05ea."
    },
    "product_type": {
      "type": "string",
      "enum": [
        "consumable",
        "subscription"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05d5\u05e6\u05e8 \u2014 \u05e0\u05d2\u05d6\u05e8 \u05de\u05d4\u05e7\u05d8\u05dc\u05d5\u05d2 \u05e9\u05d1\u05e6\u05d3 \u05d4\u05e9\u05e8\u05ea, \u05dc\u05d0 \u05de\u05d4\u05dc\u05e7\u05d5\u05d7"
    },
    "latest_transaction_id": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e1\u05e7\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05e9\u05d0\u05d5\u05de\u05ea\u05d4 \u05e2\u05d1\u05d5\u05e8 \u05d4\u05de\u05e0\u05d5\u05d9 \u05d4\u05d6\u05d4 (\u05de\u05ea\u05e2\u05d3\u05db\u05df \u05d1\u05db\u05dc \u05d7\u05d9\u05d3\u05d5\u05e9 \u05de\u05d0\u05d5\u05de\u05ea)"
    },
    "period_start": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d7\u05d9\u05dc\u05ea \u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05d7\u05d9\u05d5\u05d1 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9\u05ea \u05e9\u05dc \u05d4\u05de\u05e0\u05d5\u05d9"
    },
    "period_end": {
      "type": "string",
      "format": "date-time",
      "description": "\u05e1\u05d9\u05d5\u05dd \u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05d7\u05d9\u05d5\u05d1 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9\u05ea \u05e9\u05dc \u05d4\u05de\u05e0\u05d5\u05d9"
    },
    "credits_granted": {
      "type": "number",
      "description": "\u05e1\u05da \u05d4\u05d2'\u05d5\u05d1\u05d5\u05ea \u05e9\u05e0\u05d9\u05ea\u05e0\u05d5 \u05e2\u05d1\u05d5\u05e8 \u05d4\u05e2\u05e1\u05e7\u05d4 \u05d4\u05d6\u05d5"
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05d0\u05d5\u05de\u05ea\u05d4 \u05d4\u05d6\u05db\u05d5\u05ea \u05de\u05d5\u05dc Apple \u05d1\u05e4\u05e2\u05dd \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4"
    },
    "verification_stage": {
      "type": "string",
      "description": "\u05d4\u05e9\u05dc\u05d1 \u05e9\u05d0\u05dc\u05d9\u05d5 \u05d4\u05d2\u05d9\u05e2 \u05d4\u05d0\u05d9\u05de\u05d5\u05ea: verify_jws / entitlement_granted / duplicate_no_grant / failed_*. \u05de\u05d0\u05e4\u05e9\u05e8 \u05dc\u05d4\u05d1\u05d7\u05d9\u05df \u05d1\u05d9\u05df '\u05dc\u05d0 \u05d4\u05d2\u05d9\u05e2 \u05dc\u05e9\u05e8\u05ea' \u05dc\u05d1\u05d9\u05df '\u05d4\u05d2\u05d9\u05e2 \u05d5\u05d0\u05d9\u05de\u05d5\u05ea \u05e0\u05db\u05e9\u05dc'."
    },
    "error_category": {
      "type": "string",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d9\u05ea \u05e9\u05d2\u05d9\u05d0\u05d4 \u05db\u05dc\u05dc\u05d9\u05ea (\u05dc\u05dc\u05d0 \u05ea\u05d5\u05db\u05df \u05e8\u05d2\u05d9\u05e9 \u05d0\u05d5 payload \u05d7\u05ea\u05d5\u05dd)"
    }
  },
  "required": [
    "user_id",
    "product_id",
    "credits",
    "status"
  ]
}