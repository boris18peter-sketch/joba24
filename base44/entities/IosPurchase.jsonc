{
  "name": "IosPurchase",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d1\u05d9\u05e6\u05e2 \u05d0\u05ea \u05d4\u05e8\u05db\u05d9\u05e9\u05d4"
    },
    "product_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05d5\u05e6\u05e8 (IAP) \u05db\u05e4\u05d9 \u05e9\u05d4\u05d5\u05d2\u05d3\u05e8 \u05d1-App Store Connect"
    },
    "credits": {
      "type": "number",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05d2'\u05d5\u05d1\u05d5\u05ea \u05e9\u05e0\u05d5\u05e1\u05e4\u05d5 \u05dc\u05d9\u05ea\u05e8\u05d4"
    },
    "transaction_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e2\u05e1\u05e7\u05d4 \u05e9\u05dc Apple \u2014 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9, \u05de\u05e9\u05de\u05e9 \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05d6\u05d9\u05db\u05d5\u05d9 \u05db\u05e4\u05d5\u05dc"
    },
    "original_transaction_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e2\u05e1\u05e7\u05d4 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9\u05ea \u05e9\u05dc Apple"
    },
    "environment": {
      "type": "string",
      "enum": [
        "Sandbox",
        "Production"
      ],
      "description": "\u05e1\u05d1\u05d9\u05d1\u05ea \u05d4\u05e8\u05db\u05d9\u05e9\u05d4 \u2014 Sandbox (\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea) \u05d0\u05d5 Production"
    },
    "purchase_date": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05d5\u05e2\u05d3 \u05d4\u05e8\u05db\u05d9\u05e9\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "verified"
      ],
      "default": "verified",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d0\u05d9\u05de\u05d5\u05ea \u2014 \u05d4\u05e8\u05e9\u05d5\u05de\u05d4 \u05e0\u05d5\u05e6\u05e8\u05ea \u05e8\u05e7 \u05dc\u05d0\u05d7\u05e8 \u05d0\u05d9\u05de\u05d5\u05ea \u05d7\u05ea\u05d9\u05de\u05ea Apple \u05de\u05d5\u05dc \u05ea\u05e2\u05d5\u05d3\u05ea \u05d4\u05e9\u05d5\u05e8\u05e9"
    }
  },
  "required": [
    "user_id",
    "product_id",
    "credits",
    "transaction_id"
  ]
}