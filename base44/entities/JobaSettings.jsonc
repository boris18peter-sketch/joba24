{
  "name": "JobaSettings",
  "type": "object",
  "properties": {
    "signup_bonus": {
      "type": "number",
      "default": 60,
      "description": "\u05d1\u05d5\u05e0\u05d5\u05e1 \u05d4\u05e6\u05d8\u05e8\u05e4\u05d5\u05ea \u05d1\u05e1\u05d9\u05e1\u05d9 \u05dc\u05db\u05dc \u05de\u05e9\u05ea\u05de\u05e9 \u05d7\u05d3\u05e9 (\u05d2'\u05d5\u05d1\u05d5\u05ea)"
    },
    "referral_signup_bonus": {
      "type": "number",
      "default": 40,
      "description": "\u05d1\u05d5\u05e0\u05d5\u05e1 \u05e0\u05d5\u05e1\u05e3 \u05dc\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d4\u05d2\u05d9\u05e2 \u05d3\u05e8\u05da \u05e1\u05d5\u05db\u05df (\u05de\u05ea\u05d5\u05d5\u05e1\u05e3 \u05dc\u05d1\u05d5\u05e0\u05d5\u05e1 \u05d4\u05d1\u05e1\u05d9\u05e1\u05d9)"
    },
    "profile_completion_bonus": {
      "type": "number",
      "default": 0,
      "description": "\u05d1\u05d5\u05e0\u05d5\u05e1 \u05de\u05d9\u05dc\u05d5\u05d9 \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05e2\u05d5\u05d1\u05d3 \u05d1\u05e1\u05d9\u05d5\u05dd \u05d4\u05e6\u05d8\u05e8\u05e4\u05d5\u05ea (\u05d2'\u05d5\u05d1\u05d5\u05ea). 0 = \u05de\u05d1\u05d5\u05d8\u05dc."
    },
    "application_fee_percent": {
      "type": "number",
      "default": 5,
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05de\u05de\u05d7\u05d9\u05e8 \u05d4\u05de\u05e9\u05d9\u05de\u05d4 \u05d4\u05e0\u05d2\u05d1\u05d4 \u05e2\u05dc \u05d4\u05d2\u05e9\u05ea \u05d1\u05e7\u05e9\u05d4"
    },
    "application_fee_min": {
      "type": "number",
      "default": 1,
      "description": "\u05de\u05d9\u05e0\u05d9\u05de\u05d5\u05dd \u05d2'\u05d5\u05d1\u05d5\u05ea \u05dc\u05d7\u05d9\u05d5\u05d1 \u05d4\u05d2\u05e9\u05ea \u05d1\u05e7\u05e9\u05d4"
    },
    "story_cost": {
      "type": "number",
      "default": 10,
      "description": "\u05e2\u05dc\u05d5\u05ea \u05e4\u05e8\u05e1\u05d5\u05dd \u05e1\u05d8\u05d5\u05e8\u05d9 (\u05d2'\u05d5\u05d1\u05d5\u05ea)"
    },
    "boost_cost": {
      "type": "number",
      "default": 5,
      "description": "\u05e2\u05dc\u05d5\u05ea \u05d0\u05d9\u05ea\u05d5\u05ea (Boost) \u05e9\u05dc \u05de\u05e9\u05d9\u05de\u05d4 (\u05d2'\u05d5\u05d1\u05d5\u05ea)"
    },
    "loyalty_reward_percent": {
      "type": "number",
      "default": 10,
      "description": "\u05d0\u05d7\u05d5\u05d6 \u05de\u05d4\u05d2'\u05d5\u05d1\u05d5\u05ea \u05e9\u05d7\u05d5\u05d9\u05d1\u05d5 \u05e9\u05de\u05d5\u05d7\u05d6\u05e8 \u05db\u05d1\u05d5\u05e0\u05d5\u05e1 \u05dc\u05d5\u05d9\u05d0\u05dc\u05d8\u05d9 \u05e2\u05dc \u05d3\u05d9\u05e8\u05d5\u05d2 5 \u05db\u05d5\u05db\u05d1\u05d9\u05dd"
    },
    "loyalty_reward_min": {
      "type": "number",
      "default": 1,
      "description": "\u05de\u05d9\u05e0\u05d9\u05de\u05d5\u05dd \u05d1\u05d5\u05e0\u05d5\u05e1 \u05dc\u05d5\u05d9\u05d0\u05dc\u05d8\u05d9 (\u05d2'\u05d5\u05d1\u05d5\u05ea)"
    },
    "pre_launch_gate_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05de\u05e6\u05d1 \u05e7\u05d3\u05dd-\u05d4\u05e9\u05e7\u05d4. true = \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05e9\u05dc\u05d0 \u05d0\u05d5\u05e9\u05e8\u05d5 \u05e8\u05d5\u05d0\u05d9\u05dd \u05d0\u05ea \u05d3\u05e3 \u05d4\u05d4\u05de\u05ea\u05e0\u05d4. false = \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05e4\u05ea\u05d5\u05d7\u05d4 \u05dc\u05d7\u05dc\u05d5\u05e7\u05d4 \u05e6\u05d9\u05d1\u05d5\u05e8\u05d9\u05ea (\u05db\u05d5\u05dc\u05dd \u05e0\u05db\u05e0\u05e1\u05d9\u05dd \u05d9\u05e9\u05e8, \u05dc\u05d1\u05d3\u05d9\u05e7\u05ea App Store)."
    },
    "app_store_url": {
      "type": "string",
      "default": "",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05d9\u05e9\u05d9\u05e8 \u05dc\u05d3\u05e3 \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05d1-App Store. \u05e8\u05d9\u05e7 = \u05db\u05e4\u05ea\u05d5\u05e8 \u05de\u05d5\u05e1\u05ea\u05e8 / \u05dc\u05dc\u05d0 \u05d9\u05e2\u05d3. \u05de\u05ea\u05e2\u05d3\u05db\u05df \u05de\u05e8\u05d7\u05d5\u05e7 \u05dc\u05dc\u05d0 build \u05de\u05d7\u05d3\u05e9."
    },
    "google_play_url": {
      "type": "string",
      "default": "",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05d9\u05e9\u05d9\u05e8 \u05dc\u05d3\u05e3 \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05d1-Google Play. \u05e8\u05d9\u05e7 = \u05db\u05e4\u05ea\u05d5\u05e8 \u05de\u05d5\u05e1\u05ea\u05e8 / \u05dc\u05dc\u05d0 \u05d9\u05e2\u05d3. \u05de\u05ea\u05e2\u05d3\u05db\u05df \u05de\u05e8\u05d7\u05d5\u05e7 \u05dc\u05dc\u05d0 build \u05de\u05d7\u05d3\u05e9."
    },
    "store_buttons_enabled": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05dc\u05d4\u05e6\u05d9\u05d2 \u05d0\u05ea \u05db\u05e4\u05ea\u05d5\u05e8\u05d9 \u05d4\u05d5\u05e8\u05d3\u05ea App Store / Google Play \u05d1\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4. false = \u05de\u05e1\u05ea\u05d9\u05e8 \u05d0\u05ea \u05db\u05dc \u05d4\u05db\u05e4\u05ea\u05d5\u05e8\u05d9\u05dd (\u05de\u05ea\u05e2\u05d3\u05db\u05df \u05de\u05e8\u05d7\u05d5\u05e7)."
    },
    "updated_by": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e0\u05d4\u05dc \u05e9\u05e2\u05d3\u05db\u05df \u05dc\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4"
    }
  },
  "required": []
}