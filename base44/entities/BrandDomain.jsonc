{
  "name": "BrandDomain",
  "type": "object",
  "properties": {
    "brand_id": {
      "type": "string"
    },
    "hostname": {
      "type": "string",
      "description": "Exact lowercase hostname, never a wildcard."
    },
    "is_primary": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "disabled"
      ],
      "default": "pending",
      "description": "Brand runtime mapping only, not hosting or DNS connection."
    },
    "verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "verification_version": {
      "type": "number",
      "description": "2 requires DNS and exact-app HTTPS evidence; older checks are not trusted."
    },
    "platform_status": {
      "type": "string",
      "enum": [
        "unknown",
        "observed_connected",
        "not_confirmed"
      ],
      "default": "unknown"
    },
    "dns_status": {
      "type": "string",
      "enum": [
        "unknown",
        "verified",
        "resolved",
        "failed"
      ],
      "default": "unknown"
    },
    "check_details": {
      "type": "object",
      "additionalProperties": true,
      "description": "Last public DNS and same-host HTTPS observations, including failures and timestamp. Not a hosting management API status."
    }
  },
  "required": [
    "brand_id",
    "hostname"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}