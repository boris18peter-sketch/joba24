<?xml version="1.0" encoding="utf-8"?>
<!-- The icon bubble: the app's brand-primary-light wash inside a border-2
     hairline, radius 12 (the banner's 44/14 proportion). -->
<!-- NOTE FOR EVERY EDITOR OF THIS FILE: an XML comment may not contain a double
     hyphen. Design tokens are written here without their leading dashes for that
     reason; aapt rejects the file outright, so it is a build error, not a typo. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#EFF6FF" />
    <corners android:radius="12dp" />
    <stroke android:width="1dp" android:color="#D4E2F5" />
</shape>